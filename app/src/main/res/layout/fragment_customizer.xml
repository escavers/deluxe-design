<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.customizer.CustomizerFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/customizer_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                android:id="@+id/vehicleName"
                style="@style/Label"
                android:text="@string/customizer_vehiclename_text" />
            <ImageView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:src="@drawable/placeholder_vehicle"
                android:background="@drawable/bg_card"
                android:scaleType="fitCenter"
                android:contentDescription="@string/confirmation_hero_contentdescription"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/front"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_front_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/side"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_side_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/rear"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_rear_text" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/undo"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_undo_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/redo"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_redo_text" />
            </LinearLayout>
            <TextView
                android:id="@+id/presetLabel"
                style="@style/Label"
                android:text="@string/customizer_presetlabel_text" />
            <Spinner
                android:id="@+id/presetSelect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_field"
                android:padding="8dp"
                android:layout_marginBottom="12dp" />
            <TextView
                android:id="@+id/presetHint"
                style="@style/Label"
                android:text="@string/customizer_presethint_text" />
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/paint"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_paint_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/vinyl"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_vinyl_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wheels"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_wheels_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bodyKit"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_bodykit_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/lights"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_lights_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/accessories"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_accessories_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/interior"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="64dp"
                    android:layout_margin="3dp"
                    android:textSize="12sp"
                    android:text="@string/customizer_interior_text" />
            </GridLayout>
            <TextView
                android:id="@+id/summary"
                style="@style/Body"
                android:text="@string/customizer_summary_text" />
            <TextView
                android:id="@+id/price"
                style="@style/Title"
                android:text="@string/confirmation_price_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Primary"
                android:text="@string/customizer_save_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>