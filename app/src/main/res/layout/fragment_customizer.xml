<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.customizer.CustomizerFragment">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/customizer_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/undo"
            style="@style/Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/customizer_undo_text" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/redo"
            style="@style/Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/customizer_redo_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />

            <TextView
                android:id="@+id/vehicleName"
                style="@style/Title"
                android:text="@string/customizer_vehiclename_text" />

            <FrameLayout
                android:id="@+id/heroFrame"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/heroPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ci_porsche_front34"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@string/confirmation_hero_contentdescription" />

                <WebView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0c0e14" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/view3d"
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/customizer_expand3d_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/togglePreview"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="@string/customizer_preview_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/togglePhoto"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="@string/customizer_photo_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/front"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_front_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/side"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_side_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/rear"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_rear_text" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="@string/customizer_templates_text"
                android:layout_marginTop="18dp" />

            <LinearLayout
                android:id="@+id/templateChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp" />

            <TextView
                style="@style/Label"
                android:text="@string/customizer_configuration_text" />

            <LinearLayout
                android:id="@+id/optionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="6dp">

                <TextView
                    style="@style/Label"
                    android:text="@string/customizer_total_text"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/customizer_total_label_text"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyan"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="$ 21,400" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reset"
                style="@style/Secondary"
                android:text="@string/customizer_reset_text" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Primary"
                android:text="@string/customizer_save_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>