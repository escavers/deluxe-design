<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    tools:context="com.deluxedesign.app.ui.projects.ProjectsFragment"
>
    <!--Cabecera superior-->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        style="@style/Cabecera"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back"
            style="@style/BotonAtras"
            android:src="@drawable/ic_arrow_back_circle"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Proyectos"
            style="@style/TituloPantalla" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="84dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Cuerpo"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />

            <!--Titular: IDEAS QUE COBRAN VIDA-->
            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IDEAS QUE\nCOBRAN VIDA"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:lineSpacingExtra="4dp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="22dp" />

            <!--Vistas ocultas para compatibilidad con el binding-->
            <Spinner
                android:id="@+id/statusFilter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/newProject"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!--Fila de 3 pastillas de filtro de estado-->
            <LinearLayout
                android:id="@+id/filterPillsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!--Pastilla de activos-->
                <LinearLayout
                    android:id="@+id/pillActivos"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_filter_active"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/iconActivos"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_status_active"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/textActivos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Activos"
                        style="@style/SubtituloNegrita" />

                </LinearLayout>

                <!--Pastilla de entregados-->
                <LinearLayout
                    android:id="@+id/pillEntregados"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_filter_inactive"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/iconEntregados"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_status_delivered"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/textEntregados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Entregados"
                        style="@style/TextoAyuda" />
                </LinearLayout>

                <!--Pastilla de borradores-->
                <LinearLayout
                    android:id="@+id/pillBorradores"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_filter_inactive"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/iconBorradores"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_status_drafts"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/textBorradores"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Borradores"
                        style="@style/TextoAyuda" />
                </LinearLayout>

            </LinearLayout>

            <!--RecyclerView de proyectos-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_project"
                tools:itemCount="4" />

            <TextView
                android:id="@+id/empty"
                style="@style/EtiquetaClasica"
                android:gravity="center"
                android:text="No hay proyectos en esta categoría."
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>