<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btnBackProjects"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtProjectsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Proyectos"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBackProjects"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtIdeas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IDEAS QUE\nCOBRAN VIDA"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/txtProjectsTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/txtIdeas">

        <TextView android:id="@+id/tabActivos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activos" android:textColor="@color/white" android:background="@drawable/bg_chip_selected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/tabEntregados" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entregados" android:textColor="@color/white" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/tabBorradores" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Borradores" android:textColor="@color/white" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/txtProjectsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aún no tienes ningún proyecto guardado."
        android:textColor="@color/gray_text"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>