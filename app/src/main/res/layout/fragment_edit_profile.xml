<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBackEditProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDITAR PERFIL"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@+id/btnBackEditProfile"
            app:layout_constraintBottom_toBottomOf="@+id/btnBackEditProfile"
            app:layout_constraintStart_toEndOf="@+id/btnBackEditProfile" />

        <ImageView
            android:id="@+id/imgEditAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/img_avatar_placeholder"
            android:padding="4dp"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/txtEditTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/imgEditAvatar">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre completo" android:textColor="@color/white" />
            <EditText android:id="@+id/edtEditName" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edit_text" android:paddingHorizontal="16dp" android:textColor="@color/white" android:layout_marginTop="8dp" android:text="Samuel Jimenez" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textColor="@color/white" android:layout_marginTop="16dp" />
            <EditText android:id="@+id/edtEditEmail" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edit_text" android:paddingHorizontal="16dp" android:textColor="@color/white" android:layout_marginTop="8dp" android:text="samuelja1602@gmail.com" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teléfono" android:textColor="@color/white" android:layout_marginTop="16dp" />
            <EditText android:id="@+id/edtEditPhone" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edit_text" android:paddingHorizontal="16dp" android:textColor="@color/white" android:layout_marginTop="8dp" android:text="+591 73596502" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dirección de entrega" android:textColor="@color/white" android:layout_marginTop="16dp" />
            <EditText android:id="@+id/edtEditAddress" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_edit_text" android:paddingHorizontal="16dp" android:textColor="@color/white" android:layout_marginTop="8dp" android:text="Av. Los Sauces #23, La Paz, Bolivia" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_gradient"
                android:text="GUARDAR CAMBIOS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/btnGoToChangePass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar contraseña"
                android:textColor="@color/red_primary"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>