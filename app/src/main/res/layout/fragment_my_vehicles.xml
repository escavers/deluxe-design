<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btnBackMyVehicles"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtMyVehiclesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIS VEHÍCULOS"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/btnBackMyVehicles"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackMyVehicles"
        app:layout_constraintStart_toEndOf="@+id/btnBackMyVehicles" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyVehicles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txtMyVehiclesTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnVerCatalogo" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVerCatalogo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ VER CATALOGO"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>