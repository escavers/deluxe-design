<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    tools:context="com.deluxedesign.app.ui.projects.ProjectDetailFragment"
>
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        style="@style/CabeceraCompacta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back"
            style="@style/BotonAtrasConRelleno"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back_circle" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.025"
            android:text="@string/project_detail_reference_title"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                style="@style/TextoError"
                android:visibility="gone"
                tools:text="Mensaje de validación" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_project_hero"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/confirmation_hero_contentdescription"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_project_status_badge"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="Activo - 45%" />
            </FrameLayout>

            <TextView
                android:id="@+id/projectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="PORSCHE GT3 RS - URBAN DARK" />

            <TextView
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/inter"
                android:textColor="#AEB2BC"
                android:textSize="11sp"
                tools:text="Creado el 02 Abr 2027" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/project_detail_changes_title"
                style="@style/TituloTarjetaInter" />


            <LinearLayout
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_project_changes_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <include layout="@layout/item_project_change" android:id="@+id/paintRow" />
                <include layout="@layout/item_project_change" android:id="@+id/vinylRow" />
                <include layout="@layout/item_project_change" android:id="@+id/wheelsRow" />
                <include layout="@layout/item_project_change" android:id="@+id/bodyKitRow" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/edit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_register_button"
                android:backgroundTint="@null"
                android:elevation="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/project_detail_edit_text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/quote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_project_quote_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/inter"
                android:text="@string/new_quote_generate_text"
                android:textAllCaps="false"
                android:textColor="#FF343E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
