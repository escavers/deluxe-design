<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.catalog.VehicleDetailFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vehicle_detail_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                android:id="@+id/vehicleName"
                style="@style/Title"
                android:text="@string/customizer_vehiclename_text" />
            <TextView
                android:id="@+id/vehicleMeta"
                style="@style/Label"
                android:text="@string/vehicle_detail_vehiclemeta_text" />
            <com.deluxedesign.app.util.TouchWebView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/front"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_front_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/side"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_side_text" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/rear"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/customizer_rear_text" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/favorite"
                style="@style/Secondary"
                android:text="@string/vehicle_detail_favorite_text" />
            <TextView
                android:id="@+id/section"
                style="@style/Title"
                android:text="@string/vehicle_detail_section_text" />
            <TextView
                android:id="@+id/specifications"
                style="@style/Body"
                android:text="@string/vehicle_detail_specifications_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/customize"
                style="@style/Primary"
                android:text="@string/vehicle_detail_customize_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>