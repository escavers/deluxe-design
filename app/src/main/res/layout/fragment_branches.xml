<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btnBackBranches"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtBranchesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUCURSALES"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/btnBackBranches"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackBranches"
        app:layout_constraintStart_toEndOf="@+id/btnBackBranches" />

    <ImageView
        android:id="@+id/imgMapPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:src="@drawable/img_placeholder"
        android:background="@drawable/bg_card_charcoal"
        android:padding="32dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txtBranchesTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBranches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/imgMapPlaceholder"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>