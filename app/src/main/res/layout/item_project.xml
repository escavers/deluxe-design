<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_action_card"
    android:padding="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!--Miniatura del auto dentro de una tarjeta oscura redondeada-->
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="116dp"
        android:layout_height="80dp"
        android:layout_marginEnd="12dp"
        android:background="#151720"
        android:padding="2dp"
        android:src="@drawable/placeholder_vehicle"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <!--Datos del proyecto-->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/EtiquetaAccionMedia"
            tools:text="BMW M4 Competition" />

        <TextView
            android:id="@+id/projectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextoMeta"
            android:layout_marginBottom="6dp"
            tools:text="(nombre del proyecto)" />

        <!--Fila de barra de progreso y porcentaje-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="45"
                android:progressTint="@color/red"
                android:progressBackgroundTint="#4B5563" />

            <TextView
                android:id="@+id/progressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="45%" />
        </LinearLayout>

        <!--Fila de fecha de entrega y pastilla de estado-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_calendar_small"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/deliveryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/MetaDim"
                tools:text="Entrega aprox: 02 Abr 2027" />

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_en_proceso"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="En proceso" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
