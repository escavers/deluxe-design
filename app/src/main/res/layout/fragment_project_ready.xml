<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.projects.ProjectReadyFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/project_ready_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                android:id="@+id/projectName"
                style="@style/Title"
                android:text="@string/project_ready_projectname_text" />
            <TextView
                android:id="@+id/projectMeta"
                style="@style/Label"
                android:text="@string/vehicle_detail_vehiclemeta_text" />
            <com.deluxedesign.app.util.VehicleView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/confirmation_hero_contentdescription"
                tools:ignore="ContentDescription" />
            <TextView
                android:id="@+id/saved"
                style="@style/Label"
                android:text="@string/project_ready_saved_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Secondary"
                android:text="@string/project_ready_save_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/export"
                style="@style/Secondary"
                android:text="@string/project_ready_export_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/share"
                style="@style/Secondary"
                android:text="@string/project_ready_share_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/quote"
                style="@style/Primary"
                android:text="@string/new_quote_generate_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/home"
                style="@style/Secondary"
                android:text="@string/project_ready_home_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>