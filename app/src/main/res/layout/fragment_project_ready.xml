<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/btnBackReady"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBackReady"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_action"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROYECTO LISTO!!!"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/txtReadyProjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GT3 RS - Red Black Racing"
                android:textColor="@color/gray_text"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp" />

            <ImageView
                android:id="@+id/imgReadyPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerInside"
                android:src="@drawable/img_placeholder"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_glass" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Que deseas hacer ahora?"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_gravity="start" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewAllProjects"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Guardar en mis proyectos"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_card_charcoal"
                android:layout_marginTop="16dp"
                android:gravity="start|center_vertical"
                android:paddingStart="48dp"
                android:drawableStart="@drawable/ic_projects"
                android:drawablePadding="16dp"
                app:drawableTint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Exportar Imágenes"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_card_charcoal"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingStart="48dp"
                android:drawableStart="@drawable/ic_action"
                android:drawablePadding="16dp"
                app:drawableTint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnShareProject"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Compartir"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_card_charcoal"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingStart="48dp"
                android:drawableStart="@drawable/ic_action"
                android:drawablePadding="16dp"
                app:drawableTint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGenQuoteReady"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Generar cotizacion"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_card_charcoal"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:paddingStart="48dp"
                android:drawableStart="@drawable/ic_quotes"
                android:drawablePadding="16dp"
                app:drawableTint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver al Inicio"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_selected"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="24dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>