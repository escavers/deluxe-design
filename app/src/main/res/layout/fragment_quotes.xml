<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btnBackQuotes"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtQuotesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cotizaciones"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBackQuotes"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_notifications"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtQuotesTitle"
        app:layout_constraintBottom_toBottomOf="@+id/txtQuotesTitle" />

    <LinearLayout
        android:id="@+id/layoutStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/txtQuotesTitle">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Pendientes" android:textColor="@color/white" android:textSize="12sp" android:layout_marginEnd="16dp" android:drawableStart="@drawable/ic_quotes" android:drawablePadding="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 Aprobadas" android:textColor="@color/white" android:textSize="12sp" android:layout_marginEnd="16dp" android:drawableStart="@drawable/ic_action" android:drawablePadding="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 Rechazadas" android:textColor="@color/white" android:textSize="12sp" android:drawableStart="@drawable/ic_action" android:drawablePadding="4dp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNewQuote"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="+ Nueva cotizacion >"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_gradient"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutStats" />

    <TextView
        android:id="@+id/txtHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ultimas cotizaciones"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnNewQuote"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txtHistory"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>