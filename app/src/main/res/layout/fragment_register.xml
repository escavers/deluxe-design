<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_register_screen"
    tools:context="com.deluxedesign.app.ui.auth.RegisterFragment">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="78dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <com.deluxedesign.app.ui.common.BrandLogoView
                android:id="@+id/brandLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:importantForAccessibility="yes" />

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.01"
                android:text="@string/register_screentitle_text"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter"
                android:text="@string/register_intro_text"
                android:textColor="#C7CAD2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:textColor="#FF5964"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Mensaje de validación"
                tools:visibility="gone" />

            <TextView
                style="@style/RegisterFieldLabel"
                android:text="@string/register_name_label" />

            <EditText
                android:id="@+id/name"
                style="@style/RegisterField"
                android:autofillHints="name"
                android:hint="@string/register_name_example"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/RegisterFieldLabel"
                android:text="@string/register_email_label" />

            <EditText
                android:id="@+id/email"
                style="@style/RegisterField"
                android:autofillHints="emailAddress"
                android:hint="@string/register_email_example"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/RegisterFieldLabel"
                android:text="@string/register_phone_label" />

            <EditText
                android:id="@+id/phone"
                style="@style/RegisterField"
                android:autofillHints="phone"
                android:hint="@string/register_phone_example"
                android:inputType="phone" />

            <TextView
                style="@style/RegisterFieldLabel"
                android:text="@string/register_password_label" />

            <EditText
                android:id="@+id/password"
                style="@style/RegisterField"
                android:autofillHints="newPassword"
                android:hint="@string/register_password_example"
                android:inputType="textPassword" />

            <TextView
                style="@style/RegisterFieldLabel"
                android:text="@string/register_confirmation_label" />

            <EditText
                android:id="@+id/confirmation"
                style="@style/RegisterField"
                android:autofillHints="newPassword"
                android:hint="@string/register_password_example"
                android:inputType="textPassword" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_register_button"
                android:backgroundTint="@null"
                android:elevation="8dp"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.01"
                android:text="@string/register_create_text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/register_already_account"
                    android:textColor="#D4D6DC"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/login"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="@string/register_login_link"
                    android:textColor="#FF343E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
