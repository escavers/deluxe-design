<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.auth.RegisterFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/register_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                android:id="@+id/intro"
                style="@style/Label"
                android:text="@string/register_intro_text" />
            <EditText
                android:id="@+id/name"
                style="@style/Field"
                android:hint="@string/register_name_hint"
                android:inputType="text"
                android:autofillHints="name" />
            <EditText
                android:id="@+id/email"
                style="@style/Field"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />
            <EditText
                android:id="@+id/phone"
                style="@style/Field"
                android:hint="@string/register_phone_hint"
                android:inputType="phone"
                android:autofillHints="phone" />
            <EditText
                android:id="@+id/password"
                style="@style/Field"
                android:hint="@string/register_password_hint"
                android:inputType="textPassword"
                android:autofillHints="password" />
            <EditText
                android:id="@+id/confirmation"
                style="@style/Field"
                android:hint="@string/register_confirmation_hint"
                android:inputType="textPassword"
                android:autofillHints="password" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create"
                style="@style/Primary"
                android:text="@string/register_create_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login"
                style="@style/Secondary"
                android:text="@string/register_login_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>