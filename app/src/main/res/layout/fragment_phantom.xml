<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    android:orientation="vertical"
    tools:context="com.deluxedesign.app.ui.phantom.PhantomFragment"
>
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        style="@style/CabeceraFija">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back"
            style="@style/BotonAtrasConRelleno"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back_circle" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.06"
            android:text="DELUXE OMEGA"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_icon_circle_red"
            android:contentDescription="@string/contentdesc_avatar"
            android:padding="18dp"
            android:src="@drawable/brand_logo" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.14"
            android:text="DELUXE OMEGA"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="DELUXE OMEGA" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_branch_city"
            android:fontFamily="@font/inter"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/silver"
            android:textSize="12sp"
            tools:text="App · v1.0.0" />

        <TextView
            android:id="@+id/phrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Estás donde no deberías estar · DLX-OMEGA"
            android:textColor="@color/glow"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>