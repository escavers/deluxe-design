<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    tools:context="com.deluxedesign.app.ui.profile.ProfileFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <ImageView
                android:id="@+id/avatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/brand_logo"
                android:contentDescription="@string/profile_avatar_contentdescription" />
            <TextView
                android:id="@+id/name"
                style="@style/Title"
                android:text="@string/profile_name_text" />
            <TextView
                android:id="@+id/email"
                style="@style/Label"
                android:text="@string/profile_email_text" />
            <TextView
                android:id="@+id/counters"
                style="@style/Body"
                android:text="@string/profile_counters_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/edit"
                style="@style/Secondary"
                android:text="@string/profile_edit_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/photo"
                style="@style/Secondary"
                android:text="@string/profile_photo_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/vehicles"
                style="@style/Secondary"
                android:text="@string/profile_vehicles_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/projects"
                style="@style/Secondary"
                android:text="@string/profile_projects_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/quotes"
                style="@style/Secondary"
                android:text="@string/profile_quotes_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/notifications"
                style="@style/Secondary"
                android:text="@string/home_notifications_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/password"
                style="@style/Secondary"
                android:text="@string/profile_password_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/logout"
                style="@style/Primary"
                android:text="@string/profile_logout_text" />
            <TextView
                android:id="@+id/support"
                style="@style/Label"
                android:text="@string/profile_support_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>