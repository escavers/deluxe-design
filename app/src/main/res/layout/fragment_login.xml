<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cover"
    tools:context="com.deluxedesign.app.ui.auth.LoginFragment">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/login_screentitle_text"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Body"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                android:id="@+id/brand"
                style="@style/Title"
                android:text="@string/login_brand_text" />
            <com.deluxedesign.app.ui.common.BrandLogoView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/brand_logo"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/confirmation_hero_contentdescription"
                android:layout_marginBottom="12dp" />
            <EditText
                android:id="@+id/email"
                style="@style/Field"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />
            <EditText
                android:id="@+id/password"
                style="@style/Field"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:autofillHints="password" />
            <CheckBox
                android:id="@+id/showPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/login_showpassword_text"
                android:textColor="@color/muted" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login"
                style="@style/Primary"
                android:text="@string/login_login_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/recover"
                style="@style/Secondary"
                android:text="@string/login_recover_text" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/register"
                style="@style/Secondary"
                android:text="@string/login_register_text" />
            <TextView
                android:id="@+id/demoInfo"
                style="@style/Label"
                android:text="@string/login_demoinfo_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>