<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cover"
    tools:context="com.deluxedesign.app.ui.auth.LoginFragment">

    <!--Botón de regreso superior izquierdo-->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back_circle"
        android:scaleType="fitCenter"
        android:contentDescription="@string/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!--Título de bienvenida-->
            <TextView
                android:id="@+id/welcomeTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido a :"
                android:textColor="#E5E7EB"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!--Marca Deluxe Design-->
            <TextView
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELUXE DESIGN"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:gravity="center"
                android:layout_marginBottom="36dp" />

            <TextView
                android:id="@+id/error"
                style="@style/Cuerpo"
                android:textColor="@color/red"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                tools:text="Mensaje de validación" />

            <!--Etiqueta y campo de correo-->
            <TextView
                android:id="@+id/emailLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo:"
                style="@style/TituloTarjeta"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:layout_marginBottom="16dp" />

            <!--Etiqueta y campo de contraseña-->
            <TextView
                android:id="@+id/passwordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contraseña:"
                style="@style/TituloTarjeta"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="46dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:autofillHints="password" />

                <CheckBox
                    android:id="@+id/showPassword"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:button="@null"
                    android:background="@drawable/sl_eye_toggle"
                    android:contentDescription="Mostrar contraseña" />
            </FrameLayout>

            <!--Botón de iniciar sesión-->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login"
                style="@style/Primario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ingresar"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:layout_marginBottom="14dp" />

            <!--Inicio de sesión con Google-->
            <LinearLayout
                android:id="@+id/googleSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_google_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/login_google_text"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_google"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/login_google_text"
                    android:textColor="#1F2937"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--Enlace de recuperar contraseña-->
            <TextView
                android:id="@+id/recover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Olvidaste tu contraseña?"
                style="@style/EnlacePrimario"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <!--Enlace de registro-->
            <TextView
                android:id="@+id/register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta?  Regístrate"
                style="@style/EnlacePrimario"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/demoInfo"
                style="@style/EtiquetaClasica"
                android:gravity="center"
                android:text="@string/login_demoinfo_text"
                android:textSize="12sp"
                android:textColor="@color/muted" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>