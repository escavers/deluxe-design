<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    tools:context="com.deluxedesign.app.ui.catalog.CatalogFragment"
>
    <!--Barra superior con botón de regreso, título y campana de notificaciones-->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        style="@style/Cabecera"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back"
            style="@style/BotonAtras"
            android:src="@drawable/ic_arrow_back_circle"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/catalog_screentitle_text"
            style="@style/TituloPantalla" />


        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/notifications"
            style="@style/BotonIcono"
            android:src="@drawable/ic_notification_bell"
            android:contentDescription="@string/contentdesc_notifications" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="84dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Cuerpo"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />

            <!--Barra de busqueda-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    style="@style/CampoBusqueda"
                    android:hint="@string/catalog_search_hint"
                    android:inputType="text"
                    android:autofillHints="name" />
            </LinearLayout>

            <!--Fila de filtros con desplegables y deslizadores-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Spinner
                    android:id="@+id/brandFilter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_spinner_pill"
                    android:paddingHorizontal="8dp" />

                <Spinner
                    android:id="@+id/typeFilter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_spinner_pill"
                    android:paddingHorizontal="8dp" />

                <Spinner
                    android:id="@+id/yearFilter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner_pill"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <!--Chips horizontales de categorías-->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_filter_chip_active"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/catalog_chip_all"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipDeportivos"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/catalog_chip_sports"
                        style="@style/ChipFiltroInactivo"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipSUV"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/catalog_chip_suv"
                        style="@style/ChipFiltroInactivo"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipSedan"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/catalog_chip_sedan"
                        style="@style/ChipFiltroInactivo"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipPickUp"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/catalog_chip_pickup"
                        style="@style/ChipFiltroInactivo" />
                </LinearLayout>
            </HorizontalScrollView>

            <!--Título de sección: Resultados-->
            <TextView
                android:id="@+id/sectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_results_text"
                style="@style/TituloBienvenida"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/count"
                style="@style/EtiquetaClasica"
                android:text="@string/catalog_count_text"
                android:layout_marginBottom="4dp" />

            <!--Lista de vehículos-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_card"
                tools:itemCount="4" />

            <TextView
                android:id="@+id/empty"
                style="@style/EtiquetaClasica"
                android:text="@string/branches_empty_text"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>