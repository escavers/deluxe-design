<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    tools:context="com.deluxedesign.app.ui.home.HomeFragment"
>
    <!--Barra superior con avatar, bienvenida y campana de notificaciones-->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        style="@style/Cabecera"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--Botón de regreso oculto para conservar el binding base-->
        <View
            android:id="@+id/back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!--Avatar de usuario con aro rojo-->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/brand_logo"
            android:background="@drawable/bg_avatar_ring"
            android:padding="2dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/FormaVisual.Circulo"
            android:contentDescription="@string/contentdesc_avatar" />

        <!--Texto de bienvenida-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido!"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="Samuel Jimenez" />
        </LinearLayout>

        <!--Botón de icono de campana de notificaciones-->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/notifications"
            style="@style/BotonIcono"
            android:src="@drawable/ic_notification_bell"
            android:contentDescription="@string/contentdesc_notifications" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="84dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Cuerpo"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />

            <!--Título de pantalla y vista principal ocultos para conservar el binding-->
            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hero"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <!--Titular: IDEAS QUE COBRAN VIDA-->
            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IDEAS QUE\nCOBRAN VIDA"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:lineSpacingExtra="4dp"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="28dp" />

            <!--Cuadrícula 2x2 de accesos rápidos con efecto cristal-->
            <GridLayout
                android:id="@+id/actionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="28dp">

                <!--Nuevo proyecto-->
                <LinearLayout
                    android:id="@+id/newProject"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_action_new_project"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Nuevo\nProyecto"
                        style="@style/TituloSeccion" />

                </LinearLayout>

                <!-- Mis vehículos -->
                <LinearLayout
                    android:id="@+id/vehicles"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_action_vehicles"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Mis vehículos"
                        style="@style/TituloSeccion" />

                </LinearLayout>

                <!-- Mis diseños -->
                <LinearLayout
                    android:id="@+id/designs"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_action_designs"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Mis diseños"
                        style="@style/TituloSeccion" />

                </LinearLayout>

                <!--Sucursales-->
                <LinearLayout
                    android:id="@+id/branches"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_action_branches"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Sucursales"
                        style="@style/TituloSeccion" />

                </LinearLayout>
            </GridLayout>

            <!--Sección: Proyectos recientes con "Ver todos >"-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Proyectos recientes"
                    style="@style/TituloBienvenida" />


                <TextView
                    android:id="@+id/viewAllProjects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todos >"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!--Lista de proyectos-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_card"
                tools:itemCount="2" />

            <TextView
                android:id="@+id/empty"
                style="@style/EtiquetaClasica"
                android:text="@string/branches_empty_text"
                android:visibility="gone" />

            <!--Referencias de inspiración-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inspirationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>