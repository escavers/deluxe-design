<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/btnBackEditor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveEditor"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Guardar"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_gradient"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgEditorPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scaleType="centerInside"
        android:src="@drawable/img_placeholder"
        app:layout_constraintTop_toBottomOf="@+id/btnSaveEditor"
        app:layout_constraintBottom_toTopOf="@+id/layoutOptions" />

    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutControls">

        <ImageView android:id="@+id/btnUndo" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_action" android:layout_marginEnd="16dp" />
        <ImageView android:id="@+id/btnAngleFront" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_action" android:layout_marginEnd="16dp" />
        <ImageView android:id="@+id/btnRedo" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_action" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_card_glass"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtEditorVehicleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color del vehículo"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView android:id="@+id/btnOptionSolid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solido" android:textColor="@color/white" android:background="@drawable/bg_chip_selected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/btnOptionMatte" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mate" android:textColor="@color/white" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/btnOptionMetallic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Metalico" android:textColor="@color/white" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/btnOptionPearled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perlado" android:textColor="@color/white" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="12dp" android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <View android:id="@+id/btnColorBlack" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_unselected" android:backgroundTint="@color/black" android:layout_marginEnd="12dp" />
            <View android:id="@+id/btnColorBlue" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_unselected" android:backgroundTint="#007BFF" android:layout_marginEnd="12dp" />
            <View android:id="@+id/btnColorWhite" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_unselected" android:backgroundTint="@color/white" android:layout_marginEnd="12dp" />
            <View android:id="@+id/btnColorRed" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_unselected" android:backgroundTint="@color/red_primary" android:layout_marginEnd="12dp" />
            <View android:id="@+id/btnColorGray" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_chip_unselected" android:backgroundTint="#9E9E9E" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>