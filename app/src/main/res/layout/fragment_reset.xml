<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ContenedorPantalla"
    tools:context="com.deluxedesign.app.ui.auth.ResetFragment"
>    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        style="@style/Cabecera"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/branches_back_text"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reset_screentitle_text"
            style="@style/TituloPrincipal" />

    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">
            <TextView
                android:id="@+id/intro"
                style="@style/EtiquetaClasica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/change_password_new_label" />
            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />
            <TextView
                android:id="@+id/error"
                style="@style/Cuerpo"
                android:textColor="@color/red"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                tools:text="Mensaje de validación" />
            <TextView
                style="@style/EtiquetaClasica"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/change_password_new_example" />
            <EditText
                android:id="@+id/password"
                style="@style/Campo"
                android:hint="@string/change_password_new_example"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
            <TextView
                style="@style/EtiquetaClasica"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/change_password_confirmation_label" />
            <EditText
                android:id="@+id/confirmation"
                style="@style/Campo"
                android:hint="@string/change_password_confirmation_label"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
            <TextView
                style="@style/EtiquetaClasica"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/change_password_confirmation_example" />
            <EditText
                android:id="@+id/repeat"
                style="@style/Campo"
                android:hint="@string/change_password_confirmation_example"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Primario"
                android:text="@string/reset_save_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>