<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24FF5252" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#C21A0F16"
                android:endColor="#B00E0910"
                android:angle="270" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FF5252" />
        </shape>
    </item>
</layer-list>