<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.deluxedesignv42.ui.WelcomeFragment"
        android:label="Bienvenida"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcomeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.deluxedesignv42.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.deluxedesignv42.ui.RegisterFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.deluxedesignv42.ui.ForgotPasswordFragment"
        android:label="Recuperar"
        tools:layout="@layout/fragment_forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_resetPasswordFragment"
            app:destination="@id/resetPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.example.deluxedesignv42.ui.ResetPasswordFragment"
        android:label="Restablecer"
        tools:layout="@layout/fragment_reset_password">
        <action
            android:id="@+id/action_resetPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.deluxedesignv42.ui.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.example.deluxedesignv42.ui.CatalogFragment"
        android:label="Catálogo"
        tools:layout="@layout/fragment_catalog">
        <action
            android:id="@+id/action_catalogFragment_to_vehicleDetailFragment"
            app:destination="@id/vehicleDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/vehicleDetailFragment"
        android:name="com.example.deluxedesignv42.ui.VehicleDetailFragment"
        android:label="Detalle de Vehículo"
        tools:layout="@layout/fragment_vehicle_detail">
        <action
            android:id="@+id/action_vehicleDetailFragment_to_editorFragment"
            app:destination="@id/editorFragment" />
    </fragment>

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.example.deluxedesignv42.ui.EditorFragment"
        android:label="Editor Visual"
        tools:layout="@layout/fragment_editor">
        <action
            android:id="@+id/action_editorFragment_to_confirmDesignFragment"
            app:destination="@id/confirmDesignFragment" />
    </fragment>

    <fragment
        android:id="@+id/confirmDesignFragment"
        android:name="com.example.deluxedesignv42.ui.ConfirmDesignFragment"
        android:label="Confirmar"
        tools:layout="@layout/fragment_confirm_design">
        <action
            android:id="@+id/action_confirmDesignFragment_to_projectReadyFragment"
            app:destination="@id/projectReadyFragment" />
    </fragment>

    <fragment
        android:id="@+id/projectReadyFragment"
        android:name="com.example.deluxedesignv42.ui.ProjectReadyFragment"
        android:label="Listo"
        tools:layout="@layout/fragment_project_ready" />

    <fragment
        android:id="@+id/projectsFragment"
        android:name="com.example.deluxedesignv42.ui.ProjectsFragment"
        android:label="Proyectos"
        tools:layout="@layout/fragment_projects">
        <action
            android:id="@+id/action_projectsFragment_to_projectDetailFragment"
            app:destination="@id/projectDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/projectDetailFragment"
        android:name="com.example.deluxedesignv42.ui.ProjectDetailFragment"
        android:label="Detalle Proyecto"
        tools:layout="@layout/fragment_project_detail" />

    <fragment
        android:id="@+id/quotesFragment"
        android:name="com.example.deluxedesignv42.ui.QuotesFragment"
        android:label="Cotizaciones"
        tools:layout="@layout/fragment_quotes">
        <action
            android:id="@+id/action_quotesFragment_to_newQuoteFragment"
            app:destination="@id/newQuoteFragment" />
        <action
            android:id="@+id/action_quotesFragment_to_quoteDetailFragment"
            app:destination="@id/quoteDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/newQuoteFragment"
        android:name="com.example.deluxedesignv42.ui.NewQuoteFragment"
        android:label="Nueva Cotización"
        tools:layout="@layout/fragment_new_quote">
        <action
            android:id="@+id/action_newQuoteFragment_to_quoteDetailFragment"
            app:destination="@id/quoteDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/quoteDetailFragment"
        android:name="com.example.deluxedesignv42.ui.QuoteDetailFragment"
        android:label="Detalle Cotización"
        tools:layout="@layout/fragment_quote_detail" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.deluxedesignv42.ui.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_branchesFragment"
            app:destination="@id/branchesFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myVehiclesFragment"
            app:destination="@id/myVehiclesFragment" />
        <action
            android:id="@+id/action_profileFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.deluxedesignv42.ui.EditProfileFragment"
        android:label="Editar Perfil"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/branchesFragment"
        android:name="com.example.deluxedesignv42.ui.BranchesFragment"
        android:label="Sucursales"
        tools:layout="@layout/fragment_branches" />

    <fragment
        android:id="@+id/myVehiclesFragment"
        android:name="com.example.deluxedesignv42.ui.MyVehiclesFragment"
        android:label="Mis Vehículos"
        tools:layout="@layout/fragment_my_vehicles" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.deluxedesignv42.ui.NotificationsFragment"
        android:label="Notificaciones"
        tools:layout="@layout/fragment_notifications" />

    <action
        android:id="@+id/action_global_vehicleDetailFragment"
        app:destination="@id/vehicleDetailFragment" />

</navigation>