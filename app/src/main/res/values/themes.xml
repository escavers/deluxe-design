<?xml version="1.0" encoding="utf-8"?>
<!-- El tema de la aplicación. Los estilos compartidos viven en styles.xml. -->
<resources>
    <style name="Theme.Deluxe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryVariant">@color/red_deep</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>